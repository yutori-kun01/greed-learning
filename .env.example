# Copy this file to .env for local development (npm run dev).
# In production these are NOT read from .env — set them as Cloudflare
# Workers secrets instead (see DEPLOY.md): `wrangler secret put NAME`.

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full public URL of the deployed site (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional — leave blank to disable "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (required for paid posts and subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (required to actually deliver password-reset and email-change
# confirmation emails — without these, those emails are only logged, not sent)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# The account that signs up with this exact address becomes the ADMIN.
# Set it before the first signup, then remove it once you have your admin
# account. Leaving it set means anyone who learns the address could claim
# admin by registering it first.
BOOTSTRAP_ADMIN_EMAIL=

# Cloudflare Turnstile (optional): a bot check on sign-in, sign-up and the
# signup passcode. Leave both blank to disable. For local testing Cloudflare
# publishes always-pass test keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Uploaded images and perk files are stored in R2 through the Worker's own
# bucket binding (R2_ASSETS in wrangler.toml) — no R2 API keys are needed.
# Uploads only work when running the built Worker (`wrangler dev`), not
# under `next dev`.

# Set to "true" to enforce the Content-Security-Policy instead of only
# reporting violations. Deploy with it unset first, watch the browser console
# for violations on the real site, then turn it on.
CSP_ENFORCE=

# Local-dev only: bypass login and act as an admin without signing in.
# Never set this to true outside development.
ENABLE_DEV_BYPASS=false
